{
  "manifest_version": 3,

  "name": "Stang - Controle de Filas do Totem",

  "version": "1.0.0",

  "description": "Exibe no totem o status das filas de carga e descarga.",

  "content_scripts": [
    {
      "matches": [
        "https://app.sispetro.com.br/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ]
}
